# Copy to .env and change what you need. Every setting is optional.
# Claude is used through your local `claude` CLI login, so no API key is needed.

DATABASE_PATH=data/dateplanner.db
HEARTBEAT_SECONDS=5
MAX_PLAN_ATTEMPTS=3

CLAUDE_CLI=claude
# CLAUDE_MODEL=
CLAUDE_TIMEOUT_SECONDS=300

# Nominatim asks for a real User-Agent that identifies the app.
USER_AGENT=DatePlanner/0.1 (personal use)
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter
OSRM_URL=https://router.project-osrm.org
TRANSITOUS_URL=https://api.transitous.org
HTTP_TIMEOUT_SECONDS=20

MAX_TRANSIT_LEG_MINUTES=60
